# ======================================================
# ENTERPRISE PRICING PLATFORM — Environment Variables
# ======================================================
# Copy file ini, rename jadi .env, isi dengan nilai asli dari Supabase
# JANGAN commit file .env ke GitHub!
# ======================================================

# ----------------------------
# SUPABASE CONNECTION (WAJIB)
# ----------------------------
# Ambil dari: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXX.supabase.co

# Ambil dari: Supabase Dashboard > Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------
# OPSIONAL
# ----------------------------
# Set ke "true" jika ingin paksa pakai mock data (testing)
VITE_ENABLE_MOCK_FALLBACK=false
